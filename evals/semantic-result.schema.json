{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sleegme/DESIGN_Workflow_skill/evals/semantic-result.schema.json",
  "title": "design-workflow semantic forward-test result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executed_at",
    "commit_sha",
    "skill_version",
    "runner",
    "model",
    "reasoning_effort",
    "suite_file",
    "suite_revision",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "executed_at": {"type": "string", "format": "date-time"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "client": {"type": "string", "minLength": 1},
    "runner": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "suite_file": {"type": "string", "minLength": 1},
    "suite_revision": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed_route", "boundary_preserved", "boundary_rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "observed_route": {
            "enum": [
              "preserve",
              "expand",
              "create",
              "redesign",
              "critique",
              "brand-check",
              "translate",
              "profile"
            ]
          },
          "boundary_preserved": {"type": "boolean"},
          "boundary_rationale": {"type": "string", "minLength": 1},
          "response_excerpt": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
